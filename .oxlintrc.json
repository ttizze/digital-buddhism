{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["typescript", "unicorn", "oxc"],
	"categories": {
		"correctness": "error"
	},
	"ignorePatterns": [
		"bun.lock",
		"bun.lockb",
		"build",
		".vscode",
		".next",
		".output",
		"node_modules",
		"**/*.css",
		"**/*.md",
		"**/*.mdx",
		"**/*.yml",
		"**/*.yaml",
		"tipitaka-md",
		"tipitaka-md-nosplit",
		"tipitaka-xml",
		"playwright-report",
		"cst",
		"coverage",
		".turbo",
		".wrangler",
		".cache",
		".data",
		"dist",
		".codex",
		".claude",
		".worktree",
		".worktrees",
		"src/routeTree.gen.ts",
		"src/drizzle/meta",
		"src/drizzle/turso/meta"
	]
}
