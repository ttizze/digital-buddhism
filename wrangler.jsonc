{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "digital-buddhism",
	"compatibility_date": "2026-08-29",
	"compatibility_flags": ["nodejs_compat"],
	"main": "src/server.ts",
	"assets": {
		"binding": "ASSETS"
	},
	"images": {
		"binding": "IMAGES"
	},
	"observability": {
		"enabled": true
	}
}
