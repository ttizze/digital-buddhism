{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "digital-buddhism",
	"compatibility_date": "2026-08-29",
	"compatibility_flags": ["nodejs_compat"],
	"main": "src/server.ts",
	"upload_source_maps": true,
	"assets": {
		"binding": "ASSETS",
	},
	"kv_namespaces": [
		{
			"binding": "TIPITAKA_READ_MODELS",
			"id": "b4d21330448b4df894181807f4481543",
		},
	],
	"queues": {
		"producers": [
			{
				"binding": "TRANSLATION_QUEUE",
				"queue": "digital-buddhism-translations",
			},
		],
		"consumers": [
			{
				"queue": "digital-buddhism-translations",
				"max_batch_size": 1,
				"max_batch_timeout": 1,
				"max_retries": 3,
				"max_concurrency": 4,
				"dead_letter_queue": "digital-buddhism-translations-dlq",
			},
		],
	},
	"triggers": {
		"crons": ["* * * * *"],
	},
	"observability": {
		"enabled": true,
		"redact_query_string": true,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 0.05,
		},
	},
}
