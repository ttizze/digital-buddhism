{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "digital-buddshim",
	"compatibility_date": "2026-08-29",
	"compatibility_flags": ["nodejs_compat"],
	"main": "src/server.ts",
	"assets": {
		"binding": "ASSETS"
	},
	"images": {
		"binding": "IMAGES"
	},
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "dcff4312d5784ca0a0d0f1c92aad668b"
		}
	],
	"observability": {
		"enabled": true
	}
}
