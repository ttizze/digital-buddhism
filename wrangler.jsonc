{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "digital-buddhism",
	"compatibility_date": "2026-08-29",
	"compatibility_flags": ["nodejs_compat"],
	"main": "src/server.ts",
	"assets": {
		"binding": "ASSETS"
	},
	"images": {
		"binding": "IMAGES"
	},
	"kv_namespaces": [
		{
			"binding": "TIPITAKA_READ_MODELS",
			"id": "b4d21330448b4df894181807f4481543"
		}
	],
	"triggers": {
		"crons": ["* * * * *"]
	},
	"observability": {
		"enabled": true
	}
}
