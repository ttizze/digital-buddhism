{
	"useTabs": true,
	"tabWidth": 2,
	"printWidth": 80,
	"singleQuote": false,
	"jsxSingleQuote": false,
	"quoteProps": "as-needed",
	"trailingComma": "all",
	"semi": true,
	"arrowParens": "always",
	"bracketSameLine": false,
	"bracketSpacing": true,
	"ignorePatterns": [
		"bun.lock",
		"bun.lockb",
		"build",
		".vscode",
		".next",
		".output",
		"node_modules",
		"**/*.css",
		"**/*.md",
		"**/*.mdx",
		"**/*.yml",
		"**/*.yaml",
		"tipitaka-md",
		"tipitaka-md-nosplit",
		"tipitaka-xml",
		"playwright-report",
		"cst",
		"coverage",
		".turbo",
		".wrangler",
		".cache",
		".data",
		"dist",
		".codex",
		".claude",
		".worktree",
		".worktrees",
		"src/routeTree.gen.ts",
		"src/drizzle/meta",
		"src/drizzle/turso/meta"
	]
}
