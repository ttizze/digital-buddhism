		"tw-animate-css": "^1.4.0",
		"unified": "11.0.5",
		"unist-util-remove-position": "5.0.0",
		"unist-util-visit": "5.1.0",
		"use-intl": "^4.14.1",
		"valibot": "^1.4.2",
		"vfile": "6.0.3"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.54.2",
		"@tailwindcss/vite": "4.2.2",
		"@testing-library/dom": "10.4.1",
		"@testing-library/jest-dom": "6.9.1",
		"@testing-library/react": "16.3.2",
		"@testing-library/user-event": "14.6.1",
		"@types/mdast": "4.0.4",
		"@types/node": "25.6.0",
		"@types/react": "19.2.14",
		"@types/react-dom": "19.2.3",
		"@vitejs/plugin-react": "5.1.3",
		"@xmldom/xmldom": "0.9.9",
		"drizzle-kit": "0.31.10",
		"jsdom": "29.0.2",
		"kysely-codegen": "0.20.0",
		"oxfmt": "0.66.0",
		"oxlint": "1.77.0",
		"postcss": "8.5.9",
		"react-doctor": "0.9.12",
		"tailwindcss": "4.2.2",
		"tsx": "4.21.0",
		"typescript": "6.0.2",
		"vite": "7.3.1",
		"vitest": "4.1.4",
		"wrangler": "^4.127.1"
	},
	"overrides": {
		"css-select": "4.3.0"
	}
