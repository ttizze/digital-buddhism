{
	"name": "digital-buddhism",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bun run db:with-local -- vp dev --config vite.config.ts --port 3000",
		"build": "vp build --config vite.config.ts",
		"preview": "vp preview",
		"deploy": "vp build --config vite.config.ts && wrangler deploy",
		"cf-typegen": "wrangler types --env-interface CloudflareBindings --include-runtime false --env-file /dev/null",
		"doctor": "react-doctor --yes --no-score --no-supply-chain",
		"lint": "vp lint .",
		"format": "vp fmt .",
		"format:check": "vp fmt --check .",
		"test": "vp test",
		"db:migrate": "bun run db:with-local -- drizzle-kit migrate",
		"db:pull": "bun run db:with-local -- drizzle-kit pull",
		"db:reset": "bun run db:with-local -- --skip-migrations bun scripts/reset-local-db.ts",
		"db:generate": "bun run db:with-local -- drizzle-kit generate",
		"db:types": "bun run db:with-local -- kysely-codegen && vp fmt src/db/types.ts",
		"db:push": "bun run db:with-local -- drizzle-kit push",
		"db:studio": "bun run db:with-local -- drizzle-kit studio",
		"db:with-local": "bun scripts/with-local-db.ts",
		"db:prod:migrate": "bun scripts/turso-migrations.ts",
		"init": "vp install",
		"prepare": "vp config --no-agent",
		"typecheck": "vp exec tsc --noEmit",
		"tipitaka": "bun run db:with-local -- bun scripts/tipitaka-import.ts",
		"tipitaka:read-model": "bun run db:with-local -- bun scripts/tipitaka-read-model.ts",
		"tipitaka:read-model:remote": "bun scripts/tipitaka-read-model.ts --remote",
		"convert:romn": "bun scripts/convert-romn-to-md.ts"
	},
	"dependencies": {
		"@ai-sdk/deepseek": "^3.0.39",
		"@ai-sdk/openai": "^4.0.56",
		"@ai-sdk/valibot": "3.0.36",
		"@cloudflare/pages-plugin-vercel-og": "0.1.2",
		"@formatjs/intl-localematcher": "0.8.13",
		"@google/genai": "2.20.0",
		"@libsql/client": "^0.17.4",
		"@libsql/kysely-libsql": "^0.4.1",
		"@paralleldrive/cuid2": "3.3.0",
		"@radix-ui/react-avatar": "1.2.6",
		"@radix-ui/react-dialog": "1.1.23",
		"@radix-ui/react-dropdown-menu": "2.1.24",
		"@radix-ui/react-icons": "1.3.2",
		"@radix-ui/react-label": "2.1.15",
		"@radix-ui/react-popover": "1.1.23",
		"@radix-ui/react-progress": "1.1.16",
		"@radix-ui/react-select": "2.3.7",
		"@radix-ui/react-separator": "1.1.15",
		"@radix-ui/react-slot": "1.3.3",
		"@radix-ui/react-tabs": "1.1.21",
		"@radix-ui/react-tooltip": "1.2.16",
		"@sentry/cloudflare": "10.73.0",
		"@sentry/tanstackstart-react": "10.73.0",
		"@tailwindcss/typography": "0.5.20",
		"@tanstack/react-router": "1.170.32",
		"@tanstack/react-start": "1.168.49",
		"@valibot/to-json-schema": "1.7.1",
		"ai": "^7.0.90",
		"better-auth": "1.7.2",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "1.1.1",
		"drizzle-orm": "^0.45.2",
		"github-slugger": "2.0.0",
		"kysely": "0.29.5",
		"linkify-react": "4.3.3",
		"lucide-react": "^1.39.0",
		"mdast-util-to-markdown": "^2.1.2",
		"mdast-util-to-string": "4.0.0",
		"next-themes": "0.4.6",
		"p-limit": "7.3.2",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"react-icons": "5.7.0",
		"react-share": "5.3.0",
		"react-textarea-autosize": "8.5.9",
		"remark-parse": "11.0.0",
		"resend": "6.25.0",
		"schema-dts": "^2.0.0",
		"sonner": "2.0.8",
		"swr": "2.5.1",
		"tailwind-merge": "^3.6.0",
		"tw-animate-css": "^1.4.0",
		"unified": "11.0.5",
		"unist-util-remove-position": "5.0.0",
		"unist-util-visit": "5.1.0",
		"use-intl": "^4.14.2",
		"valibot": "^1.4.2",
		"vfile": "6.0.3"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.54.3",
		"@tailwindcss/vite": "4.3.3",
		"@testing-library/dom": "10.4.1",
		"@testing-library/jest-dom": "7.0.1",
		"@testing-library/react": "16.3.3",
		"@testing-library/user-event": "14.6.7",
		"@types/mdast": "4.0.4",
		"@types/node": "26.4.1",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.5",
		"@vitejs/plugin-react": "6.1.1",
		"@xmldom/xmldom": "0.9.12",
		"drizzle-kit": "0.31.10",
		"jsdom": "30.0.1",
		"kysely-codegen": "0.20.0",
		"react-doctor": "0.9.12",
		"tailwindcss": "4.3.3",
		"typescript": "7.0.2",
		"vite": "npm:@voidzero-dev/vite-plus-core@0.3.0",
		"vite-plus": "0.3.0",
		"wrangler": "^4.128.0"
	},
	"overrides": {
		"vite": "npm:@voidzero-dev/vite-plus-core@0.3.0",
		"vitest": "4.1.11"
	},
	"packageManager": "bun@1.4.0"
}
