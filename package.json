{
	"name": "digital-buddhism",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bun run db:with-local -- vite dev --config vite.config.ts --port 3000",
		"build": "vite build --config vite.config.ts",
		"preview": "vite preview",
		"deploy": "bun run build && wrangler deploy",
		"cf-typegen": "wrangler types",
		"doctor": "react-doctor --yes --no-score --no-supply-chain",
		"lint": "bunx oxlint .",
		"format": "bunx oxfmt .",
		"format:check": "bunx oxfmt --check .",
		"test": "vitest",
		"db:migrate": "bun run db:with-local -- drizzle-kit migrate",
		"db:pull": "bun run db:with-local -- drizzle-kit pull",
		"db:reset": "bun run db:with-local -- --skip-migrations bun scripts/reset-local-db.ts",
		"db:generate": "bun run db:with-local -- drizzle-kit generate",
		"db:types": "bun run db:with-local -- kysely-codegen && bunx oxfmt src/db/types.ts",
		"db:push": "bun run db:with-local -- drizzle-kit push",
		"db:studio": "bun run db:with-local -- drizzle-kit studio",
		"db:with-local": "bun scripts/with-local-db.ts",
		"db:prod:migrate": "bun scripts/turso-migrations.ts",
		"init": "bun install",
		"typecheck": "tsc --noEmit",
		"tipitaka": "bun run db:with-local -- bun scripts/tipitaka-import.ts",
		"tipitaka:read-model": "bun run db:with-local -- bun scripts/tipitaka-read-model.ts",
		"tipitaka:read-model:remote": "bun scripts/tipitaka-read-model.ts --remote",
		"translate": "bunx tsx scripts/translate.ts",
		"convert:romn": "bun scripts/convert-romn-to-md.ts"
	},
	"dependencies": {
		"@ai-sdk/deepseek": "^2.0.29",
		"@ai-sdk/openai": "^3.0.52",
		"@ai-sdk/valibot": "2.0.24",
		"@cloudflare/pages-plugin-vercel-og": "0.1.2",
		"@formatjs/intl-localematcher": "0.8.1",
		"@google/genai": "1.49.0",
		"@libsql/client": "^0.17.4",
		"@libsql/kysely-libsql": "^0.4.1",
		"@paralleldrive/cuid2": "3.3.0",
		"@radix-ui/react-avatar": "1.1.11",
		"@radix-ui/react-dialog": "1.1.15",
		"@radix-ui/react-dropdown-menu": "2.1.16",
		"@radix-ui/react-icons": "1.3.2",
		"@radix-ui/react-label": "2.1.8",
		"@radix-ui/react-popover": "1.1.15",
		"@radix-ui/react-progress": "1.1.8",
		"@radix-ui/react-select": "2.2.6",
		"@radix-ui/react-separator": "1.1.8",
		"@radix-ui/react-slot": "1.2.4",
		"@radix-ui/react-tabs": "1.1.13",
		"@radix-ui/react-tooltip": "1.2.8",
		"@sentry/cloudflare": "10.72.0",
		"@sentry/react": "10.72.0",
		"@sentry/tanstackstart-react": "10.72.0",
		"@tailwindcss/typography": "0.5.19",
		"@tanstack/react-router": "1.170.32",
		"@tanstack/react-start": "1.168.49",
		"@valibot/to-json-schema": "1.7.1",
		"ai": "^6.0.158",
		"better-auth": "1.6.2",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "1.1.1",
		"drizzle-orm": "^0.45.2",
		"github-slugger": "2.0.0",
		"kysely": "0.28.16",
		"linkify-react": "4.3.2",
		"lucide-react": "^1.8.0",
		"mdast-util-to-markdown": "^2.1.2",
		"mdast-util-to-string": "4.0.0",
		"next-themes": "0.4.6",
		"nuqs": "2.8.9",
		"p-limit": "7.3.0",
		"pino": "10.3.1",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"react-icons": "5.6.0",
		"react-share": "5.3.0",
		"react-textarea-autosize": "8.5.9",
		"rehype-raw": "7.0.0",
		"rehype-react": "8.0.0",
		"rehype-slug": "6.0.0",
		"remark-parse": "11.0.0",
		"remark-rehype": "11.1.2",
		"resend": "6.10.0",
