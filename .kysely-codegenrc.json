{
	"outFile": "./src/db/types.ts",
	"url": "env(TURSO_DATABASE_URL)",
	"dialect": "libsql",
	"camelCase": true,
	"excludePattern": "__drizzle_migrations",
	"customImports": {
		"JsonValue": "../drizzle/types#JsonValue",
		"PageStatus": "../drizzle/types#PageStatus",
		"SegmentTypeKey": "../drizzle/types#SegmentTypeKey",
		"TranslationProofStatus": "../drizzle/types#TranslationProofStatus",
		"TranslationStatus": "../drizzle/types#TranslationStatus"
	},
	"overrides": {
		"columns": {
			"accounts.access_token_expires_at": "Date | null",
			"accounts.created_at": "Generated<Date>",
			"accounts.refresh_token_expires_at": "Date | null",
			"accounts.updated_at": "Generated<Date>",
			"import_files.created_at": "Generated<Date>",
			"import_runs.finished_at": "Date | null",
			"import_runs.started_at": "Generated<Date>",
			"notifications.created_at": "Generated<Date>",
			"notifications.read": "Generated<boolean>",
			"pages.archived_at": "Date | null",
			"pages.created_at": "Generated<Date>",
			"pages.mdast_json": "JsonValue",
			"pages.published_at": "Date | null",
			"pages.status": "Generated<PageStatus>",
			"pages.updated_at": "Generated<Date>",
			"personal_access_tokens.created_at": "Generated<Date>",
			"personal_access_tokens.last_used_at": "Date | null",
			"segment_annotation_links.created_at": "Generated<Date>",
			"segment_metadata.created_at": "Generated<Date>",
			"segment_translations.created_at": "Generated<Date>",
			"segment_types.key": "SegmentTypeKey",
			"segments.created_at": "Generated<Date>",
			"sessions.created_at": "Generated<Date>",
			"sessions.expires_at": "Date",
			"sessions.updated_at": "Generated<Date>",
			"translation_contexts.created_at": "Generated<Date>",
			"translation_contexts.updated_at": "Generated<Date>",
			"translation_jobs.created_at": "Generated<Date>",
			"translation_jobs.status": "Generated<TranslationStatus>",
			"translation_jobs.updated_at": "Generated<Date>",
			"translation_votes.created_at": "Generated<Date>",
			"translation_votes.is_upvote": "boolean",
			"translation_votes.updated_at": "Generated<Date>",
			"user_settings.created_at": "Generated<Date>",
			"user_settings.target_locales": "Generated<string[]>",
			"user_settings.updated_at": "Generated<Date>",
			"users.created_at": "Generated<Date>",
			"users.email_verified": "boolean | null",
			"users.is_ai": "Generated<boolean>",
			"users.updated_at": "Generated<Date>",
			"verifications.created_at": "Date | null",
			"verifications.expires_at": "Date",
			"verifications.updated_at": "Date | null",
			"page_locale_translation_proofs.translation_proof_status": "Generated<TranslationProofStatus>"
		}
	}
}
